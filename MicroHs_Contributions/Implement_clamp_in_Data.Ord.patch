From 44a57dbfc137cb6e223b4150a974709e89f603fa Mon Sep 17 00:00:00 2001
From: Olivier Lischer <olivier.lischer@liolin.ch>
Date: Tue, 31 Dec 2024 13:53:27 +0100
Subject: [PATCH] Implement `clamp` in Data.Ord

---
 lib/Data/Ord.hs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/lib/Data/Ord.hs b/lib/Data/Ord.hs
index 35b08fe2..b60335f0 100644
--- a/lib/Data/Ord.hs
+++ b/lib/Data/Ord.hs
@@ -52,6 +52,9 @@ instance Bounded Ordering where
 comparing :: (Ord b) => (a -> b) -> a -> a -> Ordering
 comparing f x y = compare (f x) (f y)
 
+clamp :: (Ord a) => (a, a) -> a -> a
+clamp (low, high) a = min high (max a low)
+
 {-
 newtype Down a = Down
     { getDown :: a -- ^ @since 4.14.0.0
